{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试 TUI（D:\\sagent-smoke）",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--package=sagent-tui", "--bin=sagent-tui"]
      },
      "preLaunchTask": "构建 sagent-rpc",
      "args": [
        "--home",
        "D:\\sagent-smoke",
        "--rpc-bin",
        "${workspaceFolder}\\target\\debug\\sagent-rpc.exe"
      ],
      "cwd": "${workspaceFolder}",
      "terminal": "integrated",
      "expressions": "native",
      "env": { "RUST_BACKTRACE": "1" }
    },
    {
      "name": "调试 RPC 服务端（D:\\sagent-smoke）",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--package=sagent-rpc", "--bin=sagent-rpc"]
      },
      "args": ["--home", "D:\\sagent-smoke"],
      "cwd": "${workspaceFolder}",
      "terminal": "integrated",
      "expressions": "native",
      "env": { "RUST_BACKTRACE": "1" }
    },
    {
      "name": "附加到 TUI 创建的 sagent-rpc",
      "type": "lldb",
      "request": "attach",
      "program": "${workspaceFolder}\\target\\debug\\sagent-rpc.exe",
      "pid": "${command:pickMyProcess}",
      "stopOnEntry": false,
      "expressions": "native"
    },
    {
      "name": "调试 sagent-tui 测试",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--package=sagent-tui", "--no-run"]
      },
      "args": ["--nocapture", "--test-threads=1"],
      "cwd": "${workspaceFolder}",
      "expressions": "native",
      "env": { "RUST_BACKTRACE": "1" }
    },
    {
      "name": "调试 sagent-rpc 测试",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--package=sagent-rpc", "--no-run"]
      },
      "args": ["--nocapture", "--test-threads=1"],
      "cwd": "${workspaceFolder}",
      "expressions": "native",
      "env": { "RUST_BACKTRACE": "1" }
    },
    {
      "name": "调试 TUI（MSVC PDB）",
      "type": "cppvsdbg",
      "request": "launch",
      "preLaunchTask": "构建 TUI 与 RPC（MSVC）",
      "program": "${workspaceFolder}\\target\\debug\\sagent-tui.exe",
      "args": [
        "--home",
        "D:\\sagent-smoke",
        "--rpc-bin",
        "${workspaceFolder}\\target\\debug\\sagent-rpc.exe"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "environment": [
        { "name": "RUST_BACKTRACE", "value": "1" }
      ]
    },
    {
      "name": "附加到 TUI 创建的 sagent-rpc（MSVC PDB）",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
