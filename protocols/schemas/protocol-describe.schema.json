{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "protocol.describe 方法的响应 schema。返回协议版本、runtime 版本和 capabilities。",
  "properties": {
    "features": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "protocol": {
      "const": "sagent.rpc",
      "type": "string"
    },
    "runtime_version": {
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "protocol",
    "version",
    "runtime_version",
    "features"
  ],
  "title": "Protocol Describe Response",
  "type": "object"
}
