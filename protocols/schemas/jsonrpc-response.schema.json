{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "JSON-RPC 2.0 响应 schema。Response 必须包含 result 或 error 二者之一，不可同时存在或同时缺失。",
  "oneOf": [
    {
      "required": [
        "result"
      ]
    },
    {
      "required": [
        "error"
      ]
    }
  ],
  "properties": {
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "integer"
        },
        "data": {},
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "id": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "jsonrpc": {
      "const": "2.0",
      "type": "string"
    },
    "result": {}
  },
  "required": [
    "jsonrpc",
    "id"
  ],
  "title": "JSON-RPC Response",
  "type": "object"
}
