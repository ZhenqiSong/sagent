{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Sagent 事件通知 envelope schema。事件是 JSON-RPC notification（不带 id 字段），seq 从 1 开始按 stream 严格递增。",
  "properties": {
    "jsonrpc": {
      "const": "2.0",
      "type": "string"
    },
    "method": {
      "minLength": 1,
      "type": "string"
    },
    "params": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "object"
        },
        "event_id": {
          "type": "string"
        },
        "seq": {
          "minimum": 1,
          "type": "integer"
        },
        "session_id": {
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "turn_id": {
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "seq",
        "timestamp",
        "data"
      ],
      "type": "object"
    }
  },
  "required": [
    "jsonrpc",
    "method",
    "params"
  ],
  "title": "Event Envelope",
  "type": "object"
}
