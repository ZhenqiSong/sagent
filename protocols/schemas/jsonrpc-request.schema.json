{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "JSON-RPC 2.0 请求 schema。Request 必须包含 jsonrpc, id, method；params 必须是 object。",
  "properties": {
    "id": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        }
      ]
    },
    "jsonrpc": {
      "const": "2.0",
      "type": "string"
    },
    "method": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "params": {
      "type": "object"
    }
  },
  "required": [
    "jsonrpc",
    "id",
    "method"
  ],
  "title": "JSON-RPC Request",
  "type": "object"
}
